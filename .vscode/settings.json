{
    "chat.tools.terminal.autoApprove": {
		"npx tsc": true,
		"ForEach-Object": true,
		"mkdir": true,
		"npm pack": true,
		"tar": true,
		"Set-Location": true,
		"npm run compile": true,
		"py": true,
		"print('tables:',": true,
		"/^exit\\(\\)$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"Set-Content": true,
		"npm run build": true,
		"git rev-parse": true,
		"Test-Path": true,
		"git clone": true,
		"Test-NetConnection": true,
		"/^Set-Location \"d:\\\\OneDrive\\\\Code\\\\ai\\\\opentride\"; node -e \"const fs=require\\('fs'\\); const path=require\\('path'\\); const root='packages/protocol/schemas/v1'; const files=\\[\\]; \\(function walk\\(p\\)\\{ for\\(const ent of fs\\.readdirSync\\(p,\\{withFileTypes:true\\}\\)\\) \\{ const fp=path\\.join\\(p,ent\\.name\\); if\\(ent\\.isDirectory\\(\\)\\) walk\\(fp\\); else if\\(ent\\.isFile\\(\\) && ent\\.name\\.endsWith\\('\\.json'\\)\\) files\\.push\\(fp\\);\\} \\}\\)\\(root\\); console\\.log\\('schemas',files\\.length\\); for\\(const f of files\\)\\{ try\\{ JSON\\.parse\\(fs\\.readFileSync\\(f,'utf8'\\)\\); \\} catch\\(e\\)\\{ console\\.error\\('invalid json',f,e\\.message\\); process\\.exit\\(1\\);\\} \\} console\\.log\\('all json parse ok'\\);\"$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"npm install": true,
		"/^node packages/runtime/src/cli\\.js --port 4317$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"/^node \"d:\\\\OneDrive\\\\Code\\\\ai\\\\opentride\\\\packages\\\\runtime\\\\src\\\\cli\\.js\" --port 4317$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"/^node -e \"async function main\\(\\)\\{ const base='http://127\\.0\\.0\\.1:4317'; const hello=\\{v:'1\\.0',kind:'request',type:'hello',id:'req-1',payload:\\{client:\\{name:'smoke',version:'0\\.0'\\},capabilities:\\{sse:true,jsonRpc:false\\}\\}\\}; const r=await fetch\\(base\\+'/rpc',\\{method:'POST',headers:\\{'content-type':'application/json'\\},body:JSON\\.stringify\\(hello\\)\\}\\); console\\.log\\('hello status',r\\.status\\); console\\.log\\(await r\\.text\\(\\)\\); \\} main\\(\\)\\.catch\\(e=>\\{console\\.error\\(e\\); process\\.exit\\(1\\);\\}\\);\"$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"const": true,
		"app.get('/health',async()=>({ok:true}))": true,
		">({ok:true})": true,
		"ok:true": true,
		"console.log('ADDR',addr)": true,
		"setInterval(()=>{},1000000)": true
	},
	// 这些 reference/ 目录只是用于对照源码，不需要 TS Server 建项目；
	// 否则会因为未安装依赖而出现大量 "找不到类型定义" 的 Problems。
	"typescript.tsserver.exclude": [
		"reference/vscode-copilot-chat/**",
		"reference/copilot-api-tmp/**",
		"reference/vscodium/**"
	],
	"javascript.tsserver.exclude": [
		"reference/vscode-copilot-chat/**",
		"reference/copilot-api-tmp/**",
		"reference/vscodium/**"
	],
	// reference/vscode-copilot-chat 是用于对照的上游扩展源码；它的 package.json 会触发内置的扩展清单校验（extension-editing）并产生错误。
	// 在本仓库开发 Tripilot 时，把它当作纯文本即可避免这些噪声诊断。
	"files.associations": {
		"reference/vscode-copilot-chat/package.json": "plaintext"
	},
	"vitest.enable": true,
	"vitest.commandLine": "npm run test:watch",
	"testing.automaticallyOpenPeekView": "failureInVisibleDocument",
	"testing.defaultGutterClickAction": "run"
}